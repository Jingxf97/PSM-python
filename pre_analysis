import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

def plot_boxplots_with_stats(df, value_col, group_col):
    sns.set(style="whitegrid")
    stars = sorted(df[group_col].unique())
    plt.figure(figsize=(14, 6))
    ax = sns.boxplot(x=group_col, y=value_col, data=df)
    ax.set_title(f'{value_col} 箱型图 按{group_col}分类')
    for i, star in enumerate(stars):
        group_data = df[df[group_col] == star][value_col].dropna()
        q1 = group_data.quantile(0.25)
        q3 = group_data.quantile(0.75)
        iqr = q3 - q1
        low = q1 - 1.5*iqr
        high = q3 + 1.5*iqr
        mean = group_data.mean()
        median = group_data.median()
        # 横坐标对齐：i 是序号, 需做微调避免重叠
        ax.text(i-0.2, q1, f'Q1:{q1:.2f}', color='blue')
        ax.text(i-0.2, q3, f'Q3:{q3:.2f}', color='orange')
        ax.text(i-0.2, low, f'Q1-1.5IQR:{low:.2f}', color='green')
        ax.text(i-0.2, high, f'Q3+1.5IQR:{high:.2f}', color='red')
        ax.text(i+0.2, mean, f'Mean:{mean:.2f}', color='purple')
        ax.text(i+0.2, median, f'Median:{median:.2f}', color='brown')
    plt.xlabel(group_col)
    plt.ylabel(value_col)
    plt.tight_layout()
    plt.show()

