from scipy.stats import norm
import numpy as np

# 按star分组分别绘制正态分布曲线
stars = sorted(df1['star'].unique())
fig, axes = plt.subplots(len(stars), 2, figsize=(14, 4*len(stars)))

for idx, star in enumerate(stars):
    group = df1[df1['star'] == star]
    # yanchi_price
    sns.histplot(group['yanchi_price'], kde=True, stat='density', ax=axes[idx, 0], color='skyblue')
    mu, sigma = group['yanchi_price'].mean(), group['yanchi_price'].std()
    x = np.linspace(group['yanchi_price'].min(), group['yanchi_price'].max(), 100)
    axes[idx, 0].plot(x, norm.pdf(x, mu, sigma), 'r-', lw=2)
    axes[idx, 0].set_title(f'Star: {star} yanchi_price 正态分布\nMean={mu:.2f}, Std={sigma:.2f}')
    
    # pricediff
    sns.histplot(group['pricediff'], kde=True, stat='density', ax=axes[idx, 1], color='lightgreen')
    mu, sigma = group['pricediff'].mean(), group['pricediff'].std()
    x = np.linspace(group['pricediff'].min(), group['pricediff'].max(), 100)
    axes[idx, 1].plot(x, norm.pdf(x, mu, sigma), 'r-', lw=2)
    axes[idx, 1].set_title(f'Star: {star} pricediff 正态分布\nMean={mu:.2f}, Std={sigma:.2f}')

plt.tight_layout()
plt.show()
